<mujoco model="map2 indoor">
  <!-- timestep/iterations pinned exactly like map3 scene.xml: the scene
       <option> overrides the robot's, and plant._apply_plant_options then
       forces the PIE training dt anyway. Keep the values identical to map3
       so both scenes validate against the same contract. -->
  <option gravity="0 0 -9.81" timestep="0.01" integrator="Euler" iterations="60" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.43 0.53 0.64" rgb2="0 0 0"
             width="512" height="512" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.32 0.32 0.34" rgb2="0.24 0.24 0.26" markrgb="0.8 0.8 0.8"
             width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" />
  </asset>

  <!-- MetaCam map_2 indoor scene (spirula_ba_s2 step-50000 splat, 2.98M
       gaussians -> model/splat/map2_scene.ply). Splats carry ALL visuals;
       this file is physics only: one ground box + four boundary walls.
       Ground top z=-1.20: the spawn-footprint gaussian histogram puts the
       local floor at -1.21..-1.17 (a lower apron band sits at -1.6), and
       the gsplat-validated spawn base z=-0.755 is ~0.4 m above -1.2.
       CALIBRATED BY RENDER: if the dog's feet sink/float vs the splat
       floor, nudge plant.SCENES["map2"] ground and this box together.
       Walls fence the dog inside the splat's cleanly-captured region:
       outside it the dog-eye render degrades to mush (capture was
       handheld at ~1.2 m, only the low-capture band reads at 0.45 m
       dog-eye height). Spawn ("low") = gsplat map2_go2.json
       initial_qpos, yaw -11.49 deg. -->
  <worldbody>
    <light pos="5 -10 6" dir="-0.35 0.55 -1" directional="true" />
    <!-- ground box: x[-4,14] y[-14,4], top at z=-1.20 -->
    <geom name="floor" type="box" size="9 9 0.5" pos="5 -5 -1.7" material="groundplane"
          contype="1" conaffinity="1" />
    <!-- boundary walls, 2 m tall, translucent (same rgba as the map3
         guard rails) -->
    <geom name="wall_west"  type="box" size="0.025 9 1" pos="-4.025 -5 -0.7"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="wall_east"  type="box" size="0.025 9 1" pos="13.975 -5 -0.7"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="wall_south" type="box" size="9 0.025 1" pos="5 -13.975 -0.7"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="wall_north" type="box" size="9 0.025 1" pos="5 3.975 -0.7"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
  </worldbody>
</mujoco>
