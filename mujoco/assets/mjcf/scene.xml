<mujoco model="map3 stairwell">
  <!-- timestep/iterations MUST be pinned here (a scene <option> overrides the
       robot's). The MotrixLab training backend force-overrides the engine dt
       to SimCfg(dt=0.01) with ONE physics step per 100 Hz ctrl step — the
       deployed dynamics must match that exactly (at 0.005x2 the pivot/turn
       dynamics invert; probe-verified). -->
  <option gravity="0 0 -9.81" timestep="0.01" integrator="Euler" iterations="60" />

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="120" elevation="-20" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.43 0.53 0.64" rgb2="0 0 0"
             width="512" height="512" />
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.32 0.32 0.34" rgb2="0.24 0.24 0.26" markrgb="0.8 0.8 0.8"
             width="300" height="300" />
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="10 10" />
  </asset>

  <!-- MetaCam map_3 stairwell (spirula_ba step-30000 visual,
       map3_stairwell_rebuilt.blend collision). Splat world = LIO frame
       (scene_transform.json identity), z-up, F1 slab top at z=0.
       Collision: map3_collision.xml holds 123 exact box geoms (one per
       Blender object: 91 treads + 26 landings/connectors + 5 slabs + roof),
       generated by gsplat/tools/make_collision_xml.py -- never merged,
       never convex-hulled. The infinite plane at z=-0.05 is a deliberate
       catch-floor (user choice, dropped 5 cm below the slab tops to kill
       z-fighting flicker): the Blender model lacks the approach
       corridor floor and anything leaving a slab would otherwise fall
       through; side effect: falling into the stairwell void lands on an
       invisible floor mid-air.
       Spawn (map3_go2.json) picked by gsplat/tools/pick_spawn.py on the F1
       pass, facing the L0 stair base. Dog eye 0.45 m vs capture height
       ~1.0-1.4 m: dog-eye renders are expected mushy (map_3 has NO low
       capture stretches) -- fine for stairs-policy work, a problem for
       VIO/visual-localization use. -->
  <worldbody>
    <!-- Directional (infinite) light raking in from the E-NE at ~32 deg
         elevation: a top-down light leaves the lower floors dark behind the
         slabs above; from the side every floor gets lit (render-probe
         verified, variants A/B in the session log). -->
    <light pos="0 0 10" dir="-1 -0.35 -0.65" directional="true" />
    <!-- catch plane sits 5 cm BELOW the F1 slab tops (z=0): coplanar
         surfaces z-fight and the ground flickered in the collision/dog
         viewer. The 5 cm drop only affects the void catch height. -->
    <geom name="floor" type="plane" pos="0 0 -0.05" size="0 0 0.05" material="groundplane"
          contype="1" conaffinity="1" />
    <include file="map3_collision.xml" />
    <!-- Sim guard rails (NOT part of the Blender rebuild; the real stairwell
         has railings/walls here that the collision model omits). Four rail
         planes, probe + dog-drop verified against the exact geom table:
           1+2. central well flanks x=-9.885/-9.275 — y[1.76,4.98] spans the
                FULL flight column (flights run y[1.72,5.15]; south end 1.76
                aligns with the turn-landing north edges so no blade pokes
                through a landing surface, north end 4.98 stays clear of the
                F1 entry steps at y[5.00,6.35]), z full height to the roof.
           3.   east slot x=-8.315 (slab west edge -8.10 vs R-flight east
                edge -8.34) in FIVE z/y segments so every connector walkway
                stays open: A z[10.30,19.06] y[0.42,5.10] (F4/F5 level, above
                connector_F4/F5 y>=5.12); B1/B2 z[6.76,10.30] y[0.42,1.48] +
                y[3.02,6.48] (straddle connector_F3 y[1.50,3.00]); C
                z[2.66,6.76] y[0.42,6.48] (on top of connector_F2); D
                z[0.00,2.48] y[0.42,4.98] (ground to connector_F2, north end
                clears the F1 entry y[5.00,6.35]).
           4.   outer west wall thickened 2026-10-04: hugging only
                landing_F1_turn (-11.08) left a 260 mm vertical hole
                x[-11.08,-10.82] against the L-flight/turn-landing west
                edges (-10.820) for the full well height (only
                landing_F1_turn's own slab closed it at z[0.25,0.43]).
                East face now flush at -10.820; west face -11.130 keeps
                the S/N rail corners closed. Overlaps landing_F1_turn's
                west strip (world-world static, ignored by MuJoCo).
                Full outer ring (west/south/north/east) added: south y[0.35,0.40] and north y[6.50,6.55] span x[-11.13,-2.50]; east x[-2.50,-2.45] spans the slab edge — the dog can no longer leave a slab into the un-modelled corridor void.
         All rails touch existing geoms edge-on only — no surface blades. -->
    <geom name="rail_well_west"  type="box" size="0.025 1.610 9.555" pos="-9.885 3.370 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_well_east"  type="box" size="0.025 1.610 9.555" pos="-9.275 3.370 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_slot_A"     type="box" size="0.025 2.340 4.380" pos="-8.315 2.760 14.680"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_slot_B1"    type="box" size="0.025 0.530 1.770" pos="-8.315 0.950 8.530"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_slot_B2"    type="box" size="0.025 1.730 1.770" pos="-8.315 4.750 8.530"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_slot_C"     type="box" size="0.025 3.030 2.050" pos="-8.315 3.450 4.710"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_slot_D"     type="box" size="0.025 2.280 1.240" pos="-8.315 2.700 1.240"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_outer_west" type="box" size="0.155 3.075 9.555" pos="-10.975 3.425 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_outer_south" type="box" size="4.315 0.025 9.555" pos="-6.815 0.375 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_outer_north" type="box" size="4.315 0.025 9.555" pos="-6.815 6.525 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
    <geom name="rail_outer_east" type="box" size="0.025 3.050 9.555" pos="-2.475 3.450 9.505"
          rgba="0.85 0.30 0.25 0.1" contype="1" conaffinity="1" />
  </worldbody>
</mujoco>
