# Copy this file to .env when the host user is not uid/gid 1000.
HOST_UID=1000
HOST_GID=1000
VIDEO_GID=44
# Run `getent group render` on the host and use its numeric gid.
RENDER_GID=109

# Optional external assets. These paths are resolved on the Docker host.
TINYNAV_MODELS_DIR=../tinynav/tinynav/models
GS_PLAYGROUND_ROOT=../gs_playground
